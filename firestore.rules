rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user is accessing their own data
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated() && isOwner(userId);
      // Only allow creation if the user ID matches the auth ID
      allow create: if isAuthenticated() && isOwner(userId);
      // Allow updates to specific fields only (e.g., displayName, photoURL)
      // Prevent users from updating their own credits or plan directly
      allow update: if isAuthenticated() && isOwner(userId) 
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['credits', 'plan', 'role']);
    }

    // Projects Collection
    match /projects/{projectId} {
      // Users can read their own projects
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      
      // Users can create projects if they are the owner
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      
      // Users can update their own projects (e.g., rename, update prompt)
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      
      // Users can delete their own projects
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Marketplace Apps (Public Read)
    match /marketplace/{appId} {
      allow read: if true;
      allow write: if false; // Only admins can write via Admin SDK
    }
  }
}
